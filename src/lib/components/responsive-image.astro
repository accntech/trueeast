---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { HTMLAttributes } from 'astro/types';
type Props = Pick<
	HTMLAttributes<'img'>,
	'class' | 'loading' | 'decoding' | 'sizes' | 'fetchpriority'
> & {
	src: ImageMetadata;
	alt: string;
};
const { src, alt, ...attrs } = Astro.props;
const widths = [
	...new Set(
		[480, 768, 1280, 1920, src.width].filter((width) => width <= src.width),
	),
].sort((a, b) => a - b);
---

<Picture
	src={src}
	alt={alt}
	formats={['avif', 'webp']}
	widths={widths}
	{...attrs}
	pictureAttributes={{ class: 'contents' }}
/>
