---
interface Props {
	value: number;
	suffix?: string;
	unit?: string;
	label: string;
	decimals?: number;
}
const {
	value,
	suffix = '',
	unit = '',
	label,
	decimals = 0,
}: Props = Astro.props;

/* Word units (projects, years) read as caps by design; the kWp unit
	   symbol must keep its mixed case and sits tighter. */
const unitCls =
	unit.toLowerCase() === 'kwp'
		? 'normal-case tracking-[0.02em]'
		: 'uppercase tracking-[0.16em]';

const shown = value;
const fmt = (n: number) =>
	n.toLocaleString('en-US', {
		minimumFractionDigits: decimals,
		maximumFractionDigits: decimals,
	});
---

<div
	class="flex flex-col gap-[0.6rem]"
	data-counter={value}
	data-decimals={decimals}
>
	<div class="tabular flex items-baseline gap-[0.18em] font-display font-bold leading-[0.9] text-ink">
		<span
			class="text-[clamp(3rem,2rem+5vw,5.5rem)] tracking-[-0.02em]"
			data-counter-value
		>
			{fmt(shown)}
		</span>
		<span class="text-[clamp(2rem,1.4rem+3vw,3.4rem)] text-amber-deep">
			{suffix}
		</span>
		{unit ? (
			<>
				<span
					class={`ml-[0.3rem] text-base font-semibold ${unitCls} text-ink-faint`}
				>
					{unit}
				</span>
			</>
		) : null}
	</div>
	<div class="max-w-[22ch] text-sm leading-[1.45] text-ink-soft">{label}</div>
</div>

<script>
	import '../../scripts/counters';
</script>
