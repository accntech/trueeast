---
interface Props {
	id: string;
	name: string;
	labelledby: string;
	options: string[];
	value: string;
	class?: string;
}
const { id, name, labelledby, options, value, class: className } = Astro.props;
---

<custom-select>
	<input type="hidden" name={name} value={value} />
	<button
		id={id}
		type="button"
		role="combobox"
		aria-labelledby={labelledby}
		aria-controls={`${id}-options`}
		aria-haspopup="listbox"
		aria-expanded="false"
		class:list={[className, 'select-trigger']}
	>
		<span data-select-value>{value}</span>
		<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
			<path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.5" />
		</svg>
	</button>
	<ul id={`${id}-options`} role="listbox" aria-labelledby={labelledby} hidden>
		{options.map((option, index) => (
			<li id={`${id}-option-${index}`} role="option" aria-selected={option === value} data-value={option}>
				<span>{option}</span>
				<svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
					<path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="1.5" />
				</svg>
			</li>
		))}
	</ul>
</custom-select>

<style>
	custom-select { display: block; position: relative; }
	.select-trigger { display: flex; align-items: center; justify-content: space-between; gap: 1rem; text-align: left; cursor: pointer; }
	.select-trigger svg { flex-shrink: 0; }
	.select-trigger[aria-expanded='true'] > svg { transform: rotate(180deg); }
	ul {
		position: absolute;
		z-index: 20;
		top: calc(100% + 0.5rem);
		width: 100%;
		max-height: min(18rem, 50dvh);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.375rem;
		margin: 0;
		list-style: none;
		border: 1px solid var(--color-line-strong);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		box-shadow: 0 8px 24px color-mix(in oklch, var(--color-ink) 12%, transparent);
	}
	li { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem; border-radius: 2px; color: var(--color-ink); cursor: pointer; }
	li[aria-selected='true'] { background: var(--color-paper-2); outline: 1px solid var(--color-line-strong); outline-offset: -1px; }
	li svg { flex-shrink: 0; visibility: hidden; }
	li[data-selected='true'] svg { visibility: visible; }
</style>

<script>
	class CustomSelect extends HTMLElement {
		private events?: AbortController;

		connectedCallback() {
			this.events?.abort();
			this.events = new AbortController();
			const { signal } = this.events;
			const trigger = this.querySelector<HTMLButtonElement>('[role="combobox"]')!;
			const list = this.querySelector<HTMLElement>('[role="listbox"]')!;
			const input = this.querySelector<HTMLInputElement>('input')!;
			const initialValue = input.value;
			const label = this.querySelector<HTMLElement>('[data-select-value]')!;
			const options = [...this.querySelectorAll<HTMLElement>('[role="option"]')];
			let selected = Math.max(0, options.findIndex((option) => option.dataset.value === input.value));
			let active = selected;
			let search = '';
			let lastTyped = 0;
			const render = () => {
				options.forEach((option, index) => {
					option.setAttribute('aria-selected', String(index === (list.hidden ? selected : active)));
					option.dataset.selected = String(index === selected);
				});
				if (!list.hidden) {
					trigger.setAttribute('aria-activedescendant', options[active].id);
					options[active].scrollIntoView({ block: 'nearest' });
				}
			};
			const open = () => {
				active = selected;
				list.hidden = false;
				trigger.setAttribute('aria-expanded', 'true');
				render();
			};
			const close = (commit = false) => {
				if (commit) {
					selected = active;
					input.value = options[selected].dataset.value!;
					label.textContent = input.value;
					input.dispatchEvent(new Event('change', { bubbles: true }));
				}
				list.hidden = true;
				search = '';
				trigger.setAttribute('aria-expanded', 'false');
				trigger.removeAttribute('aria-activedescendant');
				render();
			};
			trigger.addEventListener('click', () => list.hidden ? open() : close(), { signal });
			trigger.addEventListener('keydown', (event) => {
				const wasOpen = !list.hidden;
				if (event.key === 'Tab') {
					if (wasOpen) close(true);
					return;
				}
				if (event.key === 'Escape') {
					if (wasOpen) { event.preventDefault(); close(); }
					return;
				}
				if (['Enter', ' '].includes(event.key)) {
					event.preventDefault();
					wasOpen ? close(true) : open();
					return;
				}
				if (['ArrowDown', 'ArrowUp', 'Home', 'End', 'PageUp', 'PageDown'].includes(event.key)) {
					event.preventDefault();
					if (!wasOpen) open();
					if (event.key === 'Home' || event.key === 'PageUp') active = 0;
					else if (event.key === 'End' || event.key === 'PageDown') active = options.length - 1;
					else if (wasOpen) active = Math.max(0, Math.min(options.length - 1, active + (event.key === 'ArrowDown' ? 1 : -1)));
					render();
					return;
				}
				if (event.key.length === 1 && !event.ctrlKey && !event.metaKey && !event.altKey) {
					event.preventDefault();
					if (!wasOpen) open();
					search = Date.now() - lastTyped > 700 ? event.key : search + event.key;
					lastTyped = Date.now();
					const query = search.toLowerCase();
					const repeated = [...query].every((character) => character === query[0]);
					const match = options.findIndex((_, offset) => {
						const index = repeated ? (active + offset + 1) % options.length : offset;
						return options[index].dataset.value!.toLowerCase().startsWith(repeated ? query[0] : query);
					});
					if (match >= 0) active = repeated ? (active + match + 1) % options.length : match;
					render();
				}
			}, { signal });
			options.forEach((option, index) => {
				option.addEventListener('pointerdown', (event) => event.preventDefault(), { signal });
				option.addEventListener('pointermove', () => { active = index; render(); }, { signal });
				option.addEventListener('click', () => { active = index; close(true); trigger.focus(); }, { signal });
			});
			trigger.addEventListener('blur', () => { if (!list.hidden) close(true); }, { signal });
			document.addEventListener('pointerdown', (event) => {
				if (!list.hidden && !this.contains(event.target as Node)) close(true);
			}, { signal });
			input.form?.addEventListener('reset', () => {
				selected = Math.max(0, options.findIndex((option) => option.dataset.value === initialValue));
				active = selected;
				input.value = initialValue;
				label.textContent = initialValue;
				close();
			}, { signal });
			render();
		}

		disconnectedCallback() { this.events?.abort(); }
	}
	if (!customElements.get('custom-select')) customElements.define('custom-select', CustomSelect);
</script>
