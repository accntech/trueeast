{
	"extends": "astro/tsconfigs/strict",
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"tests/**/*",
		"*.ts"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"paths": {
			"$lib/*": [
				"./src/lib/*"
			],
			"$data/*": [
				"./src/lib/data/*"
			],
			"$components/*": [
				"./src/lib/components/*"
			]
		}
	}
}
