{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "trueeast",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"MAILEROO_BASE_URL": "https://smtp.maileroo.com/api/v2/emails",
		"MAILEROO_SENDER_NAME": "True East Energy Corp.",
		"CONTACT_RECIPIENT_EMAIL": "trueeastenergy@gmail.com"
	},
	"assets": {
		"html_handling": "drop-trailing-slash"
	},
	"workers_dev": true,
	"secrets": {
		"required": [
			"MAILEROO_API_KEY",
			"MAILEROO_SENDER_EMAIL"
		]
	},
	"account_id": "5835f79f5f343c9a85d7922ecb9e3e79",
	"routes": [
		{
			"pattern": "trueeastenergy.com",
			"custom_domain": true
		}
	]
}
